---
import Logo from "./Logo.astro";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { t, type Locale, localePath } from "../i18n/utils";
import { appStoreUrl } from "../lib/appStore";

interface Props {
  locale: Locale;
  pagePath?: string;
}
const { locale, pagePath = "/" } = Astro.props;
const dict = t(locale);
const downloadHref = appStoreUrl(locale);
---

<header
  data-nav
  class="fixed top-0 left-0 right-0 z-40 transition-[background-color,border-color] duration-200"
  style="background-color: transparent; border-bottom: 1px solid transparent;"
>
  <div class="mx-auto max-w-[1320px] flex items-center justify-between px-5 md:px-10 py-3.5">
    <a
      href={localePath(locale, "/")}
      class="flex items-center"
      aria-label="MotoRival — home"
    >
      <Logo height="clamp(34px, 4.2vw, 44px)" />
    </a>

    <div class="flex items-center gap-2 md:gap-3">
      <LangSwitcher current={locale} pagePath={pagePath} />
      <ThemeToggle locale={locale} />
      <a
        href={downloadHref}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex h-9 items-center gap-2 rounded-lg border border-[color-mix(in_oklab,var(--color-accent)_32%,var(--color-line))] bg-[color-mix(in_oklab,var(--color-bg)_82%,transparent)] px-3 font-heading text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-text)] transition-[background-color,border-color,color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:bg-[color-mix(in_oklab,var(--color-accent)_8%,var(--color-bg))] hover:text-[var(--color-accent)] hover:shadow-[0_14px_30px_-20px_color-mix(in_oklab,var(--color-accent)_70%,transparent)] cursor-pointer"
      >
        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] shadow-[0_0_14px_color-mix(in_oklab,var(--color-accent)_80%,transparent)]"></span>
        <span>{dict.nav.download}</span>
      </a>
    </div>
  </div>
</header>

<!-- Spacer matches nav height: 28px (py-3.5 ×2) + clamp(34px,4.2vw,44px) logo. -->
<div aria-hidden="true" style="height: calc(28px + clamp(34px, 4.2vw, 44px));"></div>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      if (scrolled) {
        nav.style.backgroundColor = "color-mix(in oklab, var(--color-bg) 85%, transparent)";
        nav.style.borderBottomColor = "var(--color-line)";
        nav.style.backdropFilter = "blur(12px)";
        (nav.style as any).webkitBackdropFilter = "blur(12px)";
      } else {
        nav.style.backgroundColor = "transparent";
        nav.style.borderBottomColor = "transparent";
        nav.style.backdropFilter = "";
        (nav.style as any).webkitBackdropFilter = "";
      }
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
