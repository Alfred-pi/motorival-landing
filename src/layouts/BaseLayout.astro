---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { t, type Locale, alternates, localePath, withBase } from "../i18n/utils";
import { LOCALE_HREFLANG } from "../i18n/ui";
import { APP_STORE_ID, appStoreUrl } from "../lib/appStore";

interface Props {
  locale: Locale;
  /** Override the page title; defaults to the locale's home title. */
  title?: string;
  /** Override the page meta description. */
  description?: string;
  /** Path to use for hreflang alternates, e.g. "/" or "/privacy". */
  pagePath?: string;
}

const { locale, title, description, pagePath = "/" } = Astro.props;
const dict = t(locale);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = `${siteUrl}${localePath(locale, pagePath)}`;
const alts = alternates(siteUrl, pagePath);

const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;

const appUrl = appStoreUrl(locale);
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const appId = `${siteUrl}/#mobile-application`;
const pageId = `${canonical}#webpage`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "AppSprint Studio",
      url: "https://appsprint.dev",
      brand: {
        "@type": "Brand",
        name: "MotoRival",
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "MotoRival",
      url: siteUrl || undefined,
      inLanguage: LOCALE_HREFLANG[locale],
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": pageId,
      name: pageTitle,
      url: canonical,
      description: pageDescription,
      isPartOf: { "@id": websiteId },
      about: { "@id": appId },
      inLanguage: LOCALE_HREFLANG[locale],
    },
    {
      "@type": "MobileApplication",
      "@id": appId,
      name: "MotoRival",
      description: dict.meta.description,
      applicationCategory: ["SportsApplication", "GameApplication"],
      operatingSystem: "iOS",
      url: siteUrl || undefined,
      installUrl: appUrl,
      sameAs: [appUrl],
      identifier: APP_STORE_ID,
      inLanguage: LOCALE_HREFLANG[locale],
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        price: "0",
      },
      publisher: { "@id": organizationId },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: dict.faq.items.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};

const fontLinks = {
  inter: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
  satoshi: "https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500&display=swap",
};

const shouldRenderFaqSchema = pagePath === "/";
if (!shouldRenderFaqSchema) {
  jsonLd["@graph"] = jsonLd["@graph"].filter((entry) => entry["@type"] !== "FAQPage");
}

const preloadImages = locale === "fr"
  ? {
      heroPoster: `${siteUrl}/screens/optimized/us/map-us.webp`,
      frame: `${siteUrl}/frame/iphone-15-pro-no-notch.webp`,
    }
  : {
      heroPoster: `${siteUrl}/screens/optimized/us/map-us.webp`,
      frame: `${siteUrl}/frame/iphone-15-pro-no-notch.webp`,
    };
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}, app-argument=${appUrl}`} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <meta name="theme-color" content="#07080C" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)" />

    <!-- hreflang alternates -->
    {alts.map((a) => (
      <link rel="alternate" hreflang={LOCALE_HREFLANG[a.locale]} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${withBase(pagePath)}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={dict.meta.ogTitle} />
    <meta property="og:description" content={dict.meta.ogDescription} />
    <meta property="og:image" content={`${siteUrl}${import.meta.env.BASE_URL}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_HREFLANG[locale].replace("-", "_")} />
    <meta property="og:site_name" content="MotoRival" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={dict.meta.ogTitle} />
    <meta name="twitter:description" content={dict.meta.ogDescription} />
    <meta name="twitter:image" content={`${siteUrl}${import.meta.env.BASE_URL}og-image.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preload" as="image" href={preloadImages.heroPoster} fetchpriority="high" />
    <link rel="preload" as="image" href={preloadImages.frame} fetchpriority="high" />
    <link
      href={fontLinks.inter}
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      href={fontLinks.satoshi}
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href={fontLinks.inter} rel="stylesheet" />
      <link href={fontLinks.satoshi} rel="stylesheet" />
    </noscript>

    <!-- Theme init + body lock (must run before paint to avoid flash). Light by default. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("motorival.theme");
          var sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (sysDark ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
        // Lock scroll while loader is visible
        document.documentElement.classList.add("loading");
      })();
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Page loader — fades out once the page has loaded -->
    <div id="page-loader" aria-hidden="true">
      <div class="page-loader-mark">
        <img src={`${import.meta.env.BASE_URL}logo-dark.svg`} class="logo-dark" alt="" width="auto" height="44" style="height:44px;width:auto;" />
        <img src={`${import.meta.env.BASE_URL}logo-light.svg`} class="logo-light" alt="" width="auto" height="44" style="height:44px;width:auto;" />
      </div>
      <div class="page-loader-bar"><span></span></div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-3 focus:py-2 focus:bg-[var(--color-bg-3)] focus:text-[var(--color-text)] focus:rounded-md"
    >
      {dict.nav.skipToContent}
    </a>

    <Nav locale={locale} pagePath={pagePath} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Reveal-on-scroll observer + Loader release -->
    <script is:inline>
      (function () {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "-40px 0px -40px 0px", threshold: 0.1 }
        );
        document.querySelectorAll(".reveal").forEach(function (el) { io.observe(el); });

        // Release the loader after window load + min splash time
        var loader = document.getElementById("page-loader");
        var minSplash = 350; // keep brand flash without hurting LCP
        var start = performance.now();
        function releaseLoader() {
          var elapsed = performance.now() - start;
          var wait = Math.max(0, minSplash - elapsed);
          setTimeout(function () {
            if (loader) loader.classList.add("is-done");
            document.documentElement.classList.remove("loading");
            document.documentElement.classList.add("loaded");
          }, wait);
        }
        if (document.readyState === "complete") releaseLoader();
        else window.addEventListener("load", releaseLoader, { once: true });
      })();
    </script>
  </body>
</html>
